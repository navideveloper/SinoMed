# SinoMed AI Prostata local configuration.
# Copy this file to .env and adjust values for your machine.

# FastAPI model checkpoint.
PROSTATE_MODEL_PATH=runs/train/exp6/weights/best.pt

# Optional separate checkpoint for Gradio UI. If empty, app.py falls back to PROSTATE_MODEL_PATH.
GRADIO_MODEL_PATH=runs/train/exp3/weights/best.pt

# Optional API key. If set, /predict and /docs require X-API-Key.
SINOMED_API_KEY=

# Comma-separated frontend origins allowed by CORS.
SINOMED_ALLOWED_ORIGINS=https://sinomed.prapi.starify.uz,http://sinomed.prapi.starify.uz

# Upload and image safety limits.
SINOMED_MAX_UPLOAD_MB=10
SINOMED_MAX_IMAGE_PIXELS=25000000

# Set false in production to hide /docs and /openapi.json.
SINOMED_ENABLE_DOCS=false
