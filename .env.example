# =============================================
# SinoMed — production muhit o'zgaruvchilari
# Bu faylni .env ga ko'chirib to'ldiring
# =============================================

# Django
SECRET_KEY=o'zgartiring-uzoq-tasodifiy-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.uz,www.yourdomain.uz,46.224.219.146

# Database (PostgreSQL)
DB_NAME=sinomed_db
DB_USER=sinomed_user
DB_PASSWORD=kuchli-parol
DB_HOST=localhost
DB_PORT=5432

# AI Endpoints — barcha 3 model bir serverda, port bilan farqlanadi
# Faqat base URL yozing (http yoki https, port yo'q, trailing slash yo'q)
# AI server VPS da lokal ishlasa:
AI_SERVER_BASE=http://localhost
# AI server tashqi URL da ishlasa:
# AI_SERVER_BASE=https://prostataapi.starify.uz

# Agar prostata modeli API key talab qilsa:
PROSTATE_API_KEY=
