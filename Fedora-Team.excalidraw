    {
      "id": "I1GtIp-_sSXqwz_4mTzDU",
      "type": "text",
      "x": 97.75674818205403,
      "y": -616.2035561217178,
      "width": 1021.215576171875,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
