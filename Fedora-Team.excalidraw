      "isDeleted": false,
      "boundElements": [],
      "updated": 1780505022755,
      "link": null,
      "locked": false,
      "text": "Bu tahlil keyinchalik modelni qayta o'qitish va shifokorning ham\ndiqqatini oshirish uchun tibbiy o'quv keysi sifatida bazaga saqlanadi.",
