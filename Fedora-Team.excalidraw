      "isDeleted": false,
      "boundElements": [],
      "updated": 1780506429520,
      "link": null,
      "locked": false,
      "text": "Oliygohlar - Talabalarga foydasi: Tizim Oliygohlarga litsenziya\nsotish orqali ularning talabalariga tizimimizdan foydalanish\nimkoniyatini berladi - ular real bemorlarning rentgen AI tahlili\nva tajribali shifokorlarning izohlari orqali o'rganishadi.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Oliygohlar - Talabalarga foydasi: Tizim Oliygohlarga litsenziya\nsotish orqali ularning talabalariga tizimimizdan foydalanish\nimkoniyatini berladi - ular real bemorlarning rentgen AI tahlili\nva tajribali shifokorlarning izohlari orqali o'rganishadi.",
      "autoResize": true,
      "lineHeight": 1.25
    },
