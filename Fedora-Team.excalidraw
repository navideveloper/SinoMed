    {
      "id": "Oe8sTfXmoP4xsYJfZSSGG",
      "type": "text",
      "x": 91.84079385745736,
      "y": -961.1727678004617,
      "width": 1105.859375,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
