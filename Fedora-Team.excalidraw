      "isDeleted": false,
      "boundElements": [],
      "updated": 1780506898638,
      "link": null,
      "locked": false,
      "text": "Asosiy xarajatlar: Server infratuzilmasi (GPU yuklamalari), modellarni\ndoimiy o'qitish va shifokor-ekspertlar maslahati uchun xarajatlar.",
      "fontSize": 28,
      "fontFamily": 5,
