      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ar",
      "roundness": null,
      "seed": 1399989050,
      "version": 179,
      "versionNonce": 765206266,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780504785703,
      "link": null,
      "locked": false,
      "text": "Muammo: Tibbiy ta'limda AI modullar yo'q; rentgen va KT tasvirlarini tahlil qilishda\nAI ishlatilsa-da, etik va xavfsizlik standartlari belgilanmagan.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
