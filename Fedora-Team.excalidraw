      "seed": 772846266,
      "version": 82,
      "versionNonce": 1060870630,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780504969317,
      "link": null,
      "locked": false,
      "text": "Agar AI xato qilsa: AI ma'lum bir tasvirida adashsa masalan, shifokor o'pka\nyallig'lanishini ko'rib turibdi, AI esa yo'q deyapti, shifokor tizimga\n\"AI xato qildi\" deb belgi qo'yadi. Tizim shifokorni yoki AIni jazolamaydi.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Agar AI xato qilsa: AI ma'lum bir tasvirida adashsa masalan, shifokor o'pka\nyallig'lanishini ko'rib turibdi, AI esa yo'q deyapti, shifokor tizimga\n\"AI xato qildi\" deb belgi qo'yadi. Tizim shifokorni yoki AIni jazolamaydi.",
      "autoResize": true,
      "lineHeight": 1.25
    },
